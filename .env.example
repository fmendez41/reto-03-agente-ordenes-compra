# Clave del modelo. Solo la lee el backend. Nunca va al front, al repositorio ni a los logs.
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_MS=60000

# Tope de iteraciones herramienta-modelo por turno y de tokens aproximados por sesión.
MAX_TOOL_ITERATIONS=25
MAX_SESSION_TOKENS=100000
MAX_MESSAGE_CHARS=8000
# Tope del historial que viaja al modelo. Al pasarse se podan los turnos más viejos.
MAX_HISTORY_CHARS=120000

# Si se define, POST /api/chat exige Authorization: Bearer <token>.
# En un link público debe estar definido. No es la clave del modelo.
APP_ACCESS_TOKEN=

PORT=3000
